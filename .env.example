# PVModern external API configuration
# Copy the relevant variables into your server environment (for example nginx/php-fpm,
# Apache, Docker, or Magento deployment env). Do not expose these values in frontend JS.

# News provider, default base URL is https://newsapi.org/v2
NEWS_API_KEY=
NEWS_API_BASE_URL=

# Weather provider. The backend currently uses OpenWeather geocoding/current/forecast.
WEATHER_API_KEY=
OPENWEATHER_API_KEY=

# Currency provider. Frankfurter/reference fallback is used when no paid provider is configured.
CURRENCY_API_KEY=
CURRENCY_API_BASE_URL=

# Payment providers, used by checkout online payment flows when mock mode is disabled.
PVMODERN_PAYMENT_MOCK=1
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
PAYMENT_RETURN_URL=
PAYMENT_WEBHOOK_SECRET=
