<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer"/>

<!-- ═══════════════════════════════════════════════════════ SCRIPT ══ -->
<script>
(function(){
'use strict';

/* ── PHP data passed to JS ── */
var CREATE_URL   = '<?= $createUrl ?>';
var FORGOT_POST  = '<?= $forgotPostUrl ?>';

/* ── Remember me: pre-fill on load ── */
(function(){
    var saved = localStorage.getItem('pvLoginEmail');
    if (saved) {
        var el = document.getElementById('pvEmail');
        var cb = document.getElementById('rememberMe');
        if (el) el.value = saved;
        if (cb) cb.checked = true;
    }
})();

/* ── View switching ── */
window.pvSwitch = function(fromId, toId) {
    var from = document.getElementById(fromId);
    var to   = document.getElementById(toId);
    if (!from || !to) return;

    from.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
    from.style.opacity    = '0';
    from.style.transform  = 'translateY(-10px)';

    setTimeout(function(){
        from.classList.add('pv-view--hidden');
        from.style.opacity   = '';
        from.style.transform = '';

        to.classList.remove('pv-view--hidden');
        to.style.opacity   = '0';
        to.style.transform = 'translateY(12px)';

        requestAnimationFrame(function(){
            to.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
            to.style.opacity    = '1';
            to.style.transform  = 'translateY(0)';
        });
    }, 250);
};

/* ── Password show/hide — SVG eye toggle ── */
var SVG_EYE      = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
var SVG_EYE_SLASH= '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';

function pvToggleEye(inputId, btnId) {
    var input = document.getElementById(inputId);
    var btn   = document.getElementById(btnId);
    if (!input || !btn) return;
    btn.addEventListener('click', function(){
        var show = input.type === 'password'; /* true = currently hidden, about to show */
        input.type   = show ? 'text' : 'password';
        btn.innerHTML= show ? SVG_EYE_SLASH : SVG_EYE;
        btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    });
}
pvToggleEye('pvPass',    'eyePass');
pvToggleEye('pvPass2',   'eyePass2');
pvToggleEye('pvRegPass', 'eyeRegPass');
pvToggleEye('pvConfPass','eyeConfPass');

/* ── Validation helpers ── */
function isEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()); }
function isPhone(v) { return /^[0-9\s\-+]{8,15}$/.test(v.trim()); }

function setValid(fieldId, ok) {
    var field = document.getElementById(fieldId);
    if (!field) return;
    field.classList.toggle('has-error', !ok);
    field.classList.toggle('has-ok',    ok);
    var input = field.querySelector('input');
    if (input) { input.classList.toggle('pv-invalid', !ok); input.classList.toggle('pv-valid', ok); }
}
function clearValidation(fieldId) {
    var field = document.getElementById(fieldId);
    if (!field) return;
    field.classList.remove('has-error','has-ok');
    var input = field.querySelector('input');
    if (input) { input.classList.remove('pv-invalid','pv-valid'); }
}

/* Attach blur validation */
function onBlurValidate(inputId, fieldId, fn) {
    var el = document.getElementById(inputId);
    if (el) {
        el.addEventListener('blur', function(){ fn(this.value); });
        el.addEventListener('input', function(){ clearValidation(fieldId); });
    }
}

/* Login form */
onBlurValidate('pvEmail', 'fldEmail', function(v){
    setValid('fldEmail', isEmail(v));
});
onBlurValidate('pvPass', 'fldPass', function(v){
    setValid('fldPass', v.length >= 6);
});

/* Email login form */
onBlurValidate('pvEmail2', 'fldEmail2', function(v){ setValid('fldEmail2', isEmail(v)); });
onBlurValidate('pvPass2',  'fldPass2',  function(v){ setValid('fldPass2',  v.length >= 6); });

/* Phone form */
onBlurValidate('pvPhone', 'fldPhone', function(v){ setValid('fldPhone', isPhone(v)); });

/* Signup form */
onBlurValidate('pvFullName', 'fldFullName', function(v){ setValid('fldFullName', v.trim().length >= 2); });
onBlurValidate('pvRegEmail', 'fldRegEmail', function(v){ setValid('fldRegEmail', isEmail(v)); });
onBlurValidate('pvRegUser',  'fldRegUser',  function(v){ setValid('fldRegUser',  v.trim().length >= 2); });
onBlurValidate('pvRegPass',  'fldRegPass',  function(v){ setValid('fldRegPass',  v.length >= 6); });

/* Forgot password */
onBlurValidate('pvForgotEmail', 'fldForgotEmail', function(v){ setValid('fldForgotEmail', isEmail(v)); });

/* ── Login form submit ── */
var loginForm = document.getElementById('loginForm');
if (loginForm) {
    loginForm.addEventListener('submit', function(e){
        var email = document.getElementById('pvEmail').value;
        var pass  = document.getElementById('pvPass').value;
        var ok    = true;

        if (!isEmail(email)) { setValid('fldEmail', false); ok = false; }
        if (pass.length < 6) { setValid('fldPass',  false); ok = false; }
        if (!ok) { e.preventDefault(); return; }

        /* Remember me */
        if (document.getElementById('rememberMe').checked) {
            localStorage.setItem('pvLoginEmail', email);
        } else {
            localStorage.removeItem('pvLoginEmail');
        }

        /* Loading state then submit */
        e.preventDefault();
        pvBtnLoading('loginBtn', true);
        setTimeout(function(){ loginForm.submit(); }, 800);
    });
}

/* ── Email login form submit ── */
var emailLoginForm = document.getElementById('emailLoginForm');
if (emailLoginForm) {
    emailLoginForm.addEventListener('submit', function(e){
        var email = document.getElementById('pvEmail2').value;
        var pass  = document.getElementById('pvPass2').value;
        var ok    = true;
        if (!isEmail(email)) { setValid('fldEmail2', false); ok = false; }
        if (pass.length < 6) { setValid('fldPass2',  false); ok = false; }
        if (!ok) { e.preventDefault(); return; }
        e.preventDefault();
        pvBtnLoading('emailLoginBtn', true);
        setTimeout(function(){ emailLoginForm.submit(); }, 800);
    });
}

/* ── Forgot password form submit ── */
var forgotPwdForm = document.getElementById('forgotPwdForm');
if (forgotPwdForm) {
    forgotPwdForm.addEventListener('submit', function(e){
        e.preventDefault();
        var email = document.getElementById('pvForgotEmail').value.trim();
        if (!isEmail(email)) { setValid('fldForgotEmail', false); return; }

        pvBtnLoading('forgotBtn', true);
        /* POST to Magento's forgot password endpoint */
        var fd = new FormData(forgotPwdForm);
        fetch(FORGOT_POST, {
            method:'POST', body:fd, credentials:'same-origin',
            redirect:'manual'
        }).catch(function(){});

        /* Show success state after 1.5s */
        setTimeout(function(){
            pvBtnLoading('forgotBtn', false);
            document.getElementById('resetSentTo').textContent = email;
            document.getElementById('forgotForm').style.display = 'none';
            document.getElementById('forgotSuccess').classList.remove('pv-view--hidden');
        }, 1500);
    });
}

/* ── Loading state helper ── */
window.pvBtnLoading = function(btnId, on) {
    var btn = document.getElementById(btnId);
    if (!btn) return;
    if (on) { btn.classList.add('loading'); btn.disabled = true; }
    else    { btn.classList.remove('loading'); btn.disabled = false; }
};

/* ── Password strength meter ── */
window.pvStrength = function(val) {
    var bar   = document.getElementById('strengthBar');
    var label = document.getElementById('strengthLabel');
    if (!bar || !label) return;

    var score = 0;
    if (val.length >= 6)  score++;
    if (val.length >= 8)  score++;
    if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;

    var levels = [
        { pct:'20%', color:'#e74c3c', text:'Weak' },
        { pct:'40%', color:'#e67e22', text:'Fair' },
        { pct:'60%', color:'#f1c40f', text:'Good' },
        { pct:'80%', color:'#2ecc71', text:'Strong' },
        { pct:'100%',color:'#16a085', text:'Very strong' }
    ];
    var lvl = levels[Math.min(score, levels.length-1)];
    bar.style.width      = val.length ? lvl.pct : '0';
    bar.style.background = lvl.color;
    label.textContent    = val.length ? lvl.text : '';
    label.style.color    = lvl.color;
};

/* ── Confirm password match ── */
window.pvCheckMatch = function() {
    var pw  = document.getElementById('pvRegPass')  ? document.getElementById('pvRegPass').value  : '';
    var cpw = document.getElementById('pvConfPass') ? document.getElementById('pvConfPass').value : '';
    var fld = document.getElementById('fldConfPass');
    if (!fld || !cpw) return;
    if (cpw.length === 0) { clearValidation('fldConfPass'); return; }
    var match = (pw === cpw);
    fld.classList.toggle('has-error', !match);
    fld.classList.toggle('has-ok',     match);
    var input = fld.querySelector('input');
    if (input) { input.classList.toggle('pv-invalid', !match); input.classList.toggle('pv-valid', match); }
};

/* ── Signup button enable/disable ── */
window.pvToggleRegBtn = function() {
    var btn   = document.getElementById('regBtn');
    var terms = document.getElementById('termsCheck');
    if (btn && terms) btn.disabled = !terms.checked;
};

/* ── Signup create account → redirect ── */
window.pvStartReg = function() {
    var name  = document.getElementById('pvFullName')  ? document.getElementById('pvFullName').value.trim()  : '';
    var email = document.getElementById('pvRegEmail')  ? document.getElementById('pvRegEmail').value.trim()  : '';
    var user  = document.getElementById('pvRegUser')   ? document.getElementById('pvRegUser').value.trim()   : '';
    var pass  = document.getElementById('pvRegPass')   ? document.getElementById('pvRegPass').value          : '';
    var ok    = true;
    if (name.length < 2)  { setValid('fldFullName', false); ok = false; }
    if (!isEmail(email))  { setValid('fldRegEmail', false); ok = false; }
    if (user.length < 2)  { setValid('fldRegUser',  false); ok = false; }
    if (pass.length < 6)  { setValid('fldRegPass',  false); ok = false; }
    if (!ok) return;

    pvBtnLoading('regBtn', true);
    setTimeout(function(){ window.location.href = CREATE_URL; }, 600);
};

/* ── Social login click ── */
window.pvSocialClick = function(provider) {
    var labels = { google:'Google', github:'GitHub' };
    /* In production, redirect to OAuth endpoint here */
    alert('OAuth sign-in via ' + (labels[provider] || provider) + ' is not configured on this store. Please use email & password.');
};

/* ── Phone OTP flow ── */
var otpTimer;
window.pvSendOtp = function() {
    var phone = document.getElementById('pvPhone') ? document.getElementById('pvPhone').value.trim() : '';
    if (!isPhone(phone)) { setValid('fldPhone', false); return; }

    pvBtnLoading('sendOtpBtn', true);
    setTimeout(function(){
        pvBtnLoading('sendOtpBtn', false);
        document.getElementById('phoneStep1').style.display = 'none';
        document.getElementById('phoneStep2').style.display = 'block';
        document.getElementById('sentToNum').textContent = phone;
        pvStartOtpTimer(120);
        document.querySelectorAll('.pv-otp-box')[0].focus();
    }, 1500);
};

window.pvResendOtp = function() {
    clearInterval(otpTimer);
    pvStartOtpTimer(120);
    document.querySelectorAll('.pv-otp-box').forEach(function(b){ b.value = ''; });
    document.querySelectorAll('.pv-otp-box')[0].focus();
};

function pvStartOtpTimer(secs) {
    var countdown = document.getElementById('otpCountdown');
    clearInterval(otpTimer);
    otpTimer = setInterval(function(){
        secs--;
        var m = Math.floor(secs/60), s = secs%60;
        if (countdown) countdown.textContent = m + ':' + (s<10?'0':'') + s;
        if (secs <= 0) { clearInterval(otpTimer); if (countdown) countdown.textContent = '0:00'; }
    }, 1000);
}

window.pvVerifyOtp = function() {
    var boxes = document.querySelectorAll('.pv-otp-box');
    var code  = '';
    boxes.forEach(function(b){ code += b.value; });
    if (code.length < 6) { alert('Please enter the full 6-digit OTP.'); return; }
    /* In production: verify OTP via API */
    alert('OTP phone login is a demonstration. Please use email & password to sign in.');
};

/* OTP box auto-advance */
document.querySelectorAll('.pv-otp-box').forEach(function(box, i, all){
    box.addEventListener('input', function(){
        this.value = this.value.replace(/\D/g,'').slice(-1);
        if (this.value && i < all.length - 1) all[i+1].focus();
    });
    box.addEventListener('keydown', function(e){
        if (e.key === 'Backspace' && !this.value && i > 0) all[i-1].focus();
    });
});

})();
</script>
